---
import Base from '../layouts/Base.astro';
import { experience, courses, events } from '../data/site';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="About" description="About Onur Kansoy.">
<div class="wrap pagehead abt"><div><span class="kicker">About</span><h1 >Onur Kansoy</h1><p class="lead">Computer engineering student at <a href="https://en.iyte.edu.tr/">Izmir Institute of Technology</a>, planning graduate study at <a href="https://ceng.metu.edu.tr/">METU</a> from spring 2027.</p></div><img src={`${b}/media/onur.webp`} alt="Portrait of Onur Kansoy"></div>
<div class="wrap section"><h2 class="h2 rv">Experience</h2><ol class="tl">{experience.map(e=><li class="rv"><time class="mono">{e.when}</time><div><h3 style="font-size:24px">{e.role}</h3><p class="kicker" style="margin-top:4px"><a href={e.url}>{e.org}</a></p><p>{e.text}</p></div></li>)}</ol></div>
<div class="wrap section"><h2 class="h2 rv">Hackathons and game jams</h2><ol class="tl">{events.map(e=><li class="rv"><time class="mono">{e.when}</time><div><h3 style="font-size:22px">{e.url?<a href={e.url}>{e.name}</a>:e.name}</h3><p>{e.text}</p></div></li>)}</ol></div>
<div class="wrap section grid2"><div class="rv"><h2 class="h2">Courses</h2><p class="kicker">This term</p><ul class="clist">{courses.current.map(c=><li><span class="mono">{c.code}</span> {c.name}{c.note&&<em> · {c.note}</em>}</li>)}</ul><p class="kicker" style="margin-top:18px">Completed</p><ul class="clist">{courses.done.map(c=><li><span class="mono">{c.code}</span> {c.name}{c.grade&&<em> · {c.grade}</em>}</li>)}</ul></div>
<div class="rv"><h2 class="h2">Outside the lab</h2><p class="prose">I am a former president and current board member of the Iztech Bridge Society, and a former board member of the Iztech Neuroscience Society.  I also like chess, strategy games, board games and DnD, go to the theatre, and watch birds.</p><h2 class="h2" style="margin-top:28px">Languages</h2><ul class="clist"><li>Turkish, native</li><li>English, B2</li><li>Italian, beginner</li></ul></div></div>
</Base>
<style is:global>.abt{display:grid;grid-template-columns:minmax(0,1fr) minmax(180px,300px);gap:34px;align-items:end}.abt img{width:100%;border:2px solid var(--wall)}.clist{list-style:none;padding:0;margin:0;display:grid;gap:8px}.clist em{color:var(--mut);font-style:normal}.tl{list-style:none;margin:0;padding:0;border-top:2px solid var(--wall)}.tl li{display:grid;grid-template-columns:170px minmax(0,1fr);gap:20px;padding-block:18px;border-bottom:1px solid var(--line)}.tl time{font-size:13px;color:var(--mut);padding-top:5px}.tl p{max-width:68ch;margin-top:6px}
@media(max-width:700px){.abt{grid-template-columns:minmax(0,1fr);gap:22px}.abt img{max-width:220px}.tl li{grid-template-columns:minmax(0,1fr);gap:7px;padding-block:26px}.tl h3{line-height:1.2}.tl .kicker{line-height:1.55;margin-top:7px!important}.tl p{margin-top:11px;line-height:1.65}.clist{gap:14px}.clist li{line-height:1.5}.section{padding-block:44px}.section .h2{margin-bottom:18px}.kicker+.clist{margin-top:8px}}</style>
