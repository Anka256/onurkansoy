---
import Base from '../layouts/Base.astro';
import { games } from '../data/site';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Games" description="Mobile and PC games by Onur Kansoy.">
<div class="wrap pagehead"><span class="kicker">Games</span><h1 >Games I make</h1><p class="lead">Mobile and PC games I have designed and built.</p></div>
{games.map((g:any)=><section class="wrap game"><div class="gi rv"><span class={`tag ${g.cls}`}>{g.status}</span><h2>{g.name}</h2><p>{g.line}</p><div class="glinks">{g.links.map((l:any)=><a class="btn" href={l.href}>{l.label}</a>)}</div></div>
<div class="gal" data-gal><button type="button" class="ga prev" aria-label={`Previous ${g.name} image`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button><div class="gs" tabindex="0" aria-label={`${g.name} gallery`}>{g.video&&<button type="button" class="yt" data-yt={g.video} aria-label={`Play ${g.name} video`}><img src={`${b}/media/games/${g.shots[0]}.webp`} alt={`${g.name} video thumbnail`} loading="lazy"><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span></button>}{g.shots.map((s:string,k:number)=><img src={`${b}/media/games/${s}.webp`} alt={`${g.name} screenshot ${k+1}`} loading="lazy">)}</div><button type="button" class="ga next" aria-label={`Next ${g.name} image`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button></div></section>)}
</Base>
<style is:global>
.game{display:grid;grid-template-columns:minmax(0,.62fr) minmax(0,1.38fr);gap:34px;padding-block:44px;border-top:2px solid var(--wall);align-items:center}.gi{display:flex;flex-direction:column;gap:10px;align-items:flex-start;min-width:0}.gi h2{font-size:clamp(30px,3.6vw,44px);letter-spacing:-.025em}.glinks{display:flex;gap:8px;flex-wrap:wrap}
.gal{position:relative;min-width:0}.gs{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x proximity;scrollbar-width:none;scroll-behavior:smooth}.gs::-webkit-scrollbar{display:none}.gs img,.gs iframe{height:min(60svh,460px);flex:none;border:2px solid var(--wall);scroll-snap-align:start}.gs img{width:auto;max-width:none}.gs iframe{aspect-ratio:16/9;width:auto;background:#000}.yt{position:relative;padding:0;border:0;background:none;flex:none;cursor:pointer;scroll-snap-align:start}.yt span{position:absolute;inset:0;margin:auto;width:76px;height:76px;border-radius:50%;background:var(--fg);color:var(--bg);display:grid;place-items:center;transition:transform .2s}.yt:hover span{transform:scale(1.08)}.yt svg{width:36px;height:36px;fill:currentColor}
.ga{position:absolute;top:50%;translate:0 -50%;z-index:2;width:46px;height:46px;border-radius:50%;border:2px solid var(--wall);background:var(--bg);color:var(--fg);cursor:pointer;display:grid;place-items:center;padding:0;transition:opacity .2s}.ga svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}.ga:hover{background:var(--fg);color:var(--bg)}.ga[disabled]{opacity:0;pointer-events:none}.ga.prev{left:10px}.ga.next{right:10px}
@media(max-width:860px){.game{grid-template-columns:minmax(0,1fr)}.gs img,.gs iframe{height:340px}.gs iframe{height:auto;width:100%;aspect-ratio:16/9}}
</style>
<script>
document.addEventListener('astro:page-load',()=>{document.querySelectorAll<HTMLButtonElement>('[data-yt]').forEach(b=>b.onclick=()=>{const f=document.createElement('iframe');f.src=`https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1`;f.title='Gameplay video';f.allow='autoplay; encrypted-media; picture-in-picture';f.allowFullscreen=true;b.replaceWith(f)});document.querySelectorAll<HTMLElement>('[data-gal]').forEach(g=>{const s=g.querySelector<HTMLElement>('.gs')!,p=g.querySelector<HTMLButtonElement>('.prev')!,n=g.querySelector<HTMLButtonElement>('.next')!;const up=()=>{p.disabled=s.scrollLeft<=2;n.disabled=s.scrollLeft+s.clientWidth>=s.scrollWidth-2};const go=(d:number)=>s.scrollBy({left:d*Math.max(220,s.clientWidth*.75)});p.onclick=()=>go(-1);n.onclick=()=>go(1);s.addEventListener('scroll',up,{passive:true});new ResizeObserver(up).observe(s);s.querySelectorAll('img').forEach(i=>i.addEventListener('load',up));up()})});
</script>
