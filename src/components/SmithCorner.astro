<figure class="smith" aria-label="Interactive Matrix scene: Agent Smith copies spread across a grid until they collapse">
  <canvas id="smith"></canvas>
  <figcaption><span id="smc">me, too</span><em>click to add a copy</em></figcaption>
</figure>
<style is:global>
.smith{position:relative;flex:1;width:100%;margin:0;background:#17191d;border:2px solid var(--wall);min-height:420px;overflow:hidden;min-width:0;cursor:pointer}
.smith canvas{position:absolute;inset:0;width:100%;height:100%}
.smith figcaption{position:absolute;left:14px;right:14px;bottom:12px;display:flex;justify-content:space-between;gap:10px;font:12.5px var(--mono);color:#9aa3a0;pointer-events:none}
.smith figcaption span{color:#3cc482}.smith figcaption em{font-style:normal}
@media(max-width:860px){.smith{min-height:320px}}
</style>
<script>
let raf = 0, ro: ResizeObserver | null = null, io: IntersectionObserver | null = null;
document.addEventListener('astro:page-load', () => {
  const c = document.getElementById('smith') as HTMLCanvasElement | null; if (!c) return;
  const g = c.getContext('2d')!, fig = c.parentElement!, cap = document.getElementById('smc')!;
  const GL = 'ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏ0123456789:.=*+<>';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let W = 0, H = 0, cw = 0, ch = 0, nx = 0, ny = 0, ox = 0, oy = 0, vis = true, last = 0;
  let cells: { born: number; next: number }[] = [], count = 0, collapse = 0, cx = 0, cy = 0, rain: number[] = [], restart = 0;
  const rnd = (s: string) => s[(Math.random() * s.length) | 0];
  const idx = (x: number, y: number) => y * nx + x;
  const spawn = (x: number, y: number, t: number) => { const k = idx(x, y); if (x < 0 || y < 0 || x >= nx || y >= ny || cells[k].born) return false; cells[k] = { born: t, next: t + 700 + Math.random() * 900 }; count++; return true; };
  const reset = (t: number) => { cells = Array.from({ length: nx * ny }, () => ({ born: 0, next: 0 })); count = 0; collapse = 0; spawn(nx >> 1, ny >> 1, t || 1); };
  const size = () => {
    const r = c.getBoundingClientRect(), d = Math.min(devicePixelRatio || 1, 2); W = r.width; H = r.height; c.width = W * d; c.height = H * d; g.setTransform(d, 0, 0, d, 0, 0);
    const s = W < 420 ? 40 : 52; nx = Math.max(4, Math.floor((W - 20) / s)); ny = Math.max(4, Math.floor((H - 44) / (s * 1.15))); cw = (W - 20) / nx; ch = (H - 44) / ny; ox = 10; oy = 10;
    rain = Array.from({ length: Math.ceil(W / 14) }, () => Math.random() * H); reset(performance.now());
  };
  // An abstract agent: suit, white collar, dark tie, slicked hair, sunglasses with a green glint.
  const agent = (x: number, y: number, w: number, h: number, a: number, glint: number) => {
    const u = Math.min(w, h / 1.15); const mx = x + w / 2, by = y + h;
    g.globalAlpha = a;
    g.fillStyle = '#0b0c0e'; g.beginPath(); g.moveTo(mx - u * 0.46, by); g.quadraticCurveTo(mx - u * 0.44, by - u * 0.42, mx - u * 0.16, by - u * 0.5); g.lineTo(mx + u * 0.16, by - u * 0.5); g.quadraticCurveTo(mx + u * 0.44, by - u * 0.42, mx + u * 0.46, by); g.fill();
    g.fillStyle = '#d8dcd9'; g.beginPath(); g.moveTo(mx - u * 0.12, by - u * 0.5); g.lineTo(mx, by - u * 0.22); g.lineTo(mx + u * 0.12, by - u * 0.5); g.fill();
    g.fillStyle = '#1d1f22'; g.beginPath(); g.moveTo(mx - u * 0.035, by - u * 0.46); g.lineTo(mx + u * 0.035, by - u * 0.46); g.lineTo(mx + u * 0.05, by - u * 0.12); g.lineTo(mx, by - u * 0.06); g.lineTo(mx - u * 0.05, by - u * 0.12); g.fill();
    g.fillStyle = '#9aa29e'; g.beginPath(); g.ellipse(mx, by - u * 0.74, u * 0.18, u * 0.23, 0, 0, 7); g.fill();
    g.fillStyle = '#2a2c2f'; g.beginPath(); g.ellipse(mx, by - u * 0.88, u * 0.19, u * 0.11, 0, Math.PI, 0); g.fill();
    g.fillStyle = '#050606'; g.beginPath(); g.roundRect(mx - u * 0.17, by - u * 0.79, u * 0.15, u * 0.075, u * 0.03); g.roundRect(mx + u * 0.02, by - u * 0.79, u * 0.15, u * 0.075, u * 0.03); g.fill(); g.fillRect(mx - u * 0.03, by - u * 0.775, u * 0.06, u * 0.015);
    if (glint > 0) { g.fillStyle = `rgba(60,255,140,${glint})`; g.fillRect(mx - u * 0.15, by - u * 0.78, u * 0.05, u * 0.02); g.fillRect(mx + u * 0.04, by - u * 0.78, u * 0.05, u * 0.02); }
    g.globalAlpha = 1;
  };
  const frame = (t: number) => {
    g.fillStyle = '#17191d'; g.fillRect(0, 0, W, H);
    g.font = '12px "DM Mono", monospace'; g.fillStyle = 'rgba(60,196,130,.16)';
    rain.forEach((y, i) => { g.fillText(rnd(GL), i * 14, y); rain[i] = y > H ? 0 : y + 6; });
    if (!collapse && t > restart) {
      for (let y = 0; y < ny; y++) for (let x = 0; x < nx; x++) { const k = cells[idx(x, y)]; if (k.born && t > k.next) { const d = [[1, 0], [-1, 0], [0, 1], [0, -1]].sort(() => Math.random() - 0.5); for (const [a, b] of d) if (spawn(x + a, y + b, t)) break; k.next = t + 900 + Math.random() * 1400; } }
      if (count >= nx * ny) { collapse = t; cx = W / 2; cy = H / 2; }
    }
    const R = collapse ? (t - collapse) * 0.55 : -1;
    for (let y = 0; y < ny; y++) for (let x = 0; x < nx; x++) {
      const k = cells[idx(x, y)]; if (!k.born) continue; const px = ox + x * cw, py = oy + y * ch, age = t - k.born;
      if (collapse && Math.hypot(px + cw / 2 - cx, py + ch / 2 - cy) < R) continue;
      if (age < 420) { g.fillStyle = '#3cc482'; g.font = `${Math.floor(cw * 0.32)}px "DM Mono", monospace`; for (let i = 0; i < 6; i++) g.fillText(rnd(GL), px + Math.random() * cw * 0.8, py + Math.random() * ch * 0.9 + 10); agent(px, py, cw, ch, age / 420, 0); }
      else agent(px, py, cw, ch, 1, Math.max(0, Math.sin(t / 500 + x * 1.3 + y * 0.7)) * 0.9);
    }
    if (collapse) {
      const gr = g.createRadialGradient(cx, cy, Math.max(0, R - 60), cx, cy, R + 20); gr.addColorStop(0, 'rgba(232,255,240,0)'); gr.addColorStop(0.75, 'rgba(232,255,240,.85)'); gr.addColorStop(1, 'rgba(232,255,240,0)');
      g.fillStyle = gr; g.fillRect(0, 0, W, H);
      if (R > Math.hypot(W, H)) { reset(t); restart = t + 900; }
    }
    const txt = collapse ? 'Mr. Anderson...' : count < 3 ? 'me, too' : `${count} copies of ${nx * ny}`; if (cap.textContent !== txt) cap.textContent = txt;
  };
  fig.addEventListener('click', (e) => { if (collapse) return; const r = c.getBoundingClientRect(), x = Math.floor((e.clientX - r.left - ox) / cw), y = Math.floor((e.clientY - r.top - oy) / ch); spawn(x, y, performance.now()); });
  const loop = (t: number) => { raf = requestAnimationFrame(loop); if (!vis || t - last < 33) return; last = t; frame(t); };
  ro = new ResizeObserver(() => { size(); if (reduce) { for (let k = 0; k < nx * ny * 0.4; k++) spawn((Math.random() * nx) | 0, (Math.random() * ny) | 0, 1); frame(5000); } }); ro.observe(c); size();
  if (reduce) return;
  io = new IntersectionObserver((e) => (vis = e[0].isIntersecting)); io.observe(c); raf = requestAnimationFrame(loop);
});
document.addEventListener('astro:before-swap', () => { cancelAnimationFrame(raf); ro?.disconnect(); io?.disconnect(); });
</script>
